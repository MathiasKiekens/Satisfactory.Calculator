<Window x:Class="Hyperion.Satisfactory.Calculator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hyperion.Satisfactory.Calculator.UI"
        mc:Ignorable="d"
        Title="Welcome" Height="450" Width="800"
        Background="#2E2E2E" Foreground="White">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome to the Factory Calculator"
                       FontSize="24"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Margin="0,0,0,20"/>
            <Button Name="LoadSaveButton"
                    Content="Load Existing Save"
                    Width="200"
                    Height="50"
                    Margin="0,0,0,10"
                    Click="LoadSaveButton_OnClick"
                    Background="#FF8C00" Foreground="White" BorderBrush="White"/>
            <Button Name="NewSaveButton"
                    Content="Start New Save"
                    Width="200"
                    Height="50"
                    Margin="0,0,0,10"
                    Click="NewSaveButton_OnClick"
                    Background="#FF8C00" Foreground="White" BorderBrush="White"/>
        </StackPanel>
    </Grid>
</Window>